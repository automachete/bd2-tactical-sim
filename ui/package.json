{
  "name": "bd2-tactical-sim-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"tests/**/*.ts\" vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-svelte": "^3.12.1",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  }
}
