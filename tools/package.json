{
  "name": "bd2-data-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "scripts": {
    "sync": "node sync-bd2db.mjs",
    "validate:catalog": "node validate-catalog.mjs",
    "validate:equipment": "node validate-bd2db-equipment.mjs",
    "validate:icons": "node validate-character-icons.mjs",
    "verify": "npm run validate:catalog && npm run validate:equipment && npm run validate:icons",
    "test:ui": "playwright test -c playwright.config.mjs",
    "test:ui:quality": "playwright test -c playwright.config.mjs model-based-quality.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
